# Server-only settings. Copy to api/.env for local development; do not commit it.
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Supabase (server side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-or-publishable-key
# Server-only. Required for private storage upload and deletion; never expose this to web/.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Direct database connection used by SQLAlchemy/migrations
# Use Supabase's server-side connection string (never a NEXT_PUBLIC_ variable).
DATABASE_URL=postgresql+psycopg://postgres:replace-with-password@db.your-project.supabase.co:5432/postgres

# RAG providers (server-only; mock mode is the safe local default and makes no paid calls)
# Supported options for EMBEDDING_PROVIDER & LANGUAGE_MODEL_PROVIDER: "mock", "gemini", "openai"
EMBEDDING_PROVIDER=mock
LANGUAGE_MODEL_PROVIDER=mock

# Google Gemini (free tier via https://aistudio.google.com/)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_RESPONSE_MODEL=gemini-2.0-flash

# OpenAI (optional)
OPENAI_API_KEY=replace-with-your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
RESPONSE_MODEL=gpt-4.1-mini
RAG_MATCH_THRESHOLD=0.45
RAG_MAX_CHUNKS=5
RAG_QUESTION_MAX_CHARS=2000

# Public-chat protections
REDIS_URL=redis://localhost:6379/0
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60

# Upload policy
MAX_UPLOAD_BYTES=10485760
SUPABASE_STORAGE_BUCKET=supportdock-documents
